<?xml version="1.0" encoding="utf-8"?>
<!-- ModeHelper: a SYSTEM app with NO UI. It must stay separate from the UI app:
     a uid-system process with a WebView crashes the privileged process.
     Everything that needs privilege lives here, headless. Every entry point that
     other apps can reach is guarded by a signature permission. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.geely.modehelper"
    android:sharedUserId="android.uid.system"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="28" />

    <!-- Held only by apps signed with the same key as this one. -->
    <permission android:name="com.geely.modehelper.permission.CONTROL"
        android:protectionLevel="signature" />

    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />
    <uses-permission android:name="android.car.permission.CAR_ENERGY" />
    <uses-permission android:name="android.car.permission.CAR_MILEAGE" />
    <uses-permission android:name="android.car.permission.CAR_EXTERIOR_ENVIRONMENT" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- WifiGuardReceiver holds a partial wakelock while on the trusted network. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Silent install/uninstall (Installer). signature|privileged: granted by the platform key. -->
    <uses-permission android:name="android.permission.INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- AdbControl writes Settings.Global.ADB_ENABLED. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <!-- Bluetooth: command-line pairing (BtPairReceiver) and BluetoothKeeper. -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.BLUETOOTH_PRIVILEGED" />

    <application android:name=".HelperApp" android:label="ModeHelper" android:allowBackup="false">
        <service android:name=".ModeHelperService" android:exported="false" />

        <!-- System broadcasts and own alarms only; no permission possible here. -->
        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.ACTION_BOOT_HU" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="com.geely.modehelper.WATCHDOG" />
            </intent-filter>
        </receiver>

        <receiver android:name=".InstallReceiver" android:exported="true"
            android:permission="com.geely.modehelper.permission.CONTROL">
            <intent-filter>
                <action android:name="com.geely.modehelper.INSTALL_APK" />
            </intent-filter>
        </receiver>
        <receiver android:name=".InstallResultReceiver" android:exported="false" />

        <!-- Read-only diagnostic: adb shell am broadcast -a com.geely.modehelper.READPROP ... -->
        <receiver android:name=".ProbeReceiver" android:exported="true"
            android:permission="com.geely.modehelper.permission.CONTROL">
            <intent-filter>
                <action android:name="com.geely.modehelper.READPROP" />
            </intent-filter>
        </receiver>

        <!-- Range estimate: print it, or change window / capacity. -->
        <receiver android:name=".RangeReceiver" android:exported="true"
            android:permission="com.geely.modehelper.permission.CONTROL">
            <intent-filter>
                <action android:name="com.geely.modehelper.RANGE" />
            </intent-filter>
        </receiver>

        <!-- Keep Bluetooth on after the car starts: status and switches. -->
        <receiver android:name=".BtKeepReceiver" android:exported="true"
            android:permission="com.geely.modehelper.permission.CONTROL">
            <intent-filter>
                <action android:name="com.geely.modehelper.BT_KEEP" />
            </intent-filter>
        </receiver>

        <!-- Remembered drive and regeneration modes: status and manual control. -->
        <receiver android:name=".ModeReceiver" android:exported="true"
            android:permission="com.geely.modehelper.permission.CONTROL">
            <intent-filter>
                <action android:name="com.geely.modehelper.SET_MODE" />
            </intent-filter>
        </receiver>

        <receiver android:name=".AdbReceiver" android:exported="true"
            android:permission="com.geely.modehelper.permission.CONTROL">
            <intent-filter>
                <action android:name="com.geely.modehelper.SET_ADB" />
            </intent-filter>
        </receiver>

        <receiver android:name=".WifiGuardReceiver" android:exported="true"
            android:permission="com.geely.modehelper.permission.CONTROL">
            <intent-filter>
                <action android:name="com.geely.modehelper.WIFI_GUARD_CHECK" />
                <action android:name="com.geely.modehelper.SET_TRUSTED_WIFI" />
            </intent-filter>
        </receiver>

        <receiver android:name=".BtPairReceiver" android:exported="true"
            android:permission="com.geely.modehelper.permission.CONTROL">
            <intent-filter>
                <action android:name="com.geely.modehelper.BT_PAIR" />
            </intent-filter>
        </receiver>
    </application>
</manifest>